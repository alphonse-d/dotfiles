;; Refresh-on-miss: MELPA only keeps the latest build of each package, so a
;; cached archive index gradually points at tarballs that have been rotated
;; away (install then 404s). This advice retries `package-install' once after
;; refreshing the index, so a stale index self-heals instead of erroring.
(defun my/package-install-refresh-on-miss (orig pkg &rest args)
  "Retry ORIG `package-install' for PKG (with ARGS) once after refreshing."
  (condition-case nil
      (apply orig pkg args)
    (error (package-refresh-contents)
           (apply orig pkg args))))
(advice-add 'package-install :around #'my/package-install-refresh-on-miss)

