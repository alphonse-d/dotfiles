;;;; Org: prompt for a SCHEDULED date when a task enters WAIT
(defun my/org-wait-reschedule ()
  "Prompt for a SCHEDULED date when a task enters WAIT."
  (when (equal org-state "WAIT")
    (org-schedule nil)))
(add-hook 'org-after-todo-state-change-hook #'my/org-wait-reschedule)

;;;; Org: EMC2 TRACK links — type e.g. QAN.1235123 then space to expand
(defvar my/emc2-track-prefixes
  '(("SLG" . "SLG")
    ("QAN" . "ZQN"))
  "Map the prefix you TYPE -> the EMC2 TRACK URL segment.")

(defun my/org-emc2-linkify ()
  "Convert a TRACK id like QAN.1235123 before point into a full org link.
Returns non-nil when it converted something."
  (let ((rx (concat "\\(" (mapconcat #'car my/emc2-track-prefixes "\\|")
                    "\\)\\.\\([0-9]+\\)")))
    (when (looking-back rx (line-beginning-position))
      (let* ((prefix (match-string 1))
             (id     (match-string 2))
             (seg    (cdr (assoc prefix my/emc2-track-prefixes))))
        (replace-match
         (format "[[https://emc2summary/GetSummaryReport.ashx/TRACK/%s/%s][%s%s]]"
                 seg id prefix id)
         t t)   ; FIXEDCASE: don't upcase the URL to match "QAN"; LITERAL: no \-escapes
        t))))

(defun my/org-emc2-linkify-maybe ()
  "Linkify a TRACK id right after a separator is typed."
  (when (memq (char-before) '(?\s ?\n ?\t))
    (save-excursion
      (goto-char (1- (point)))
      (my/org-emc2-linkify))))

(add-hook 'org-mode-hook
          (lambda ()
            (add-hook 'post-self-insert-hook #'my/org-emc2-linkify-maybe nil t)))

