;;;; Vulpea: tag notes with :project: and feed them into the agenda
(defun vulpea-buffer-p ()
  "Return non-nil if the currently visited buffer is a note."
  (and buffer-file-name
       (eq major-mode 'org-mode)
       (string-prefix-p
        (expand-file-name (file-name-as-directory org-roam-directory))
        (file-name-directory buffer-file-name))))

(defun vulpea-project-p ()
  "Return non-nil if current buffer has any todo entry.
TODO entries marked as done are ignored, meaning the this
function returns nil if current buffer contains only completed
tasks."
  (seq-find
   (lambda (type)
     (eq type 'todo))
   (org-element-map
    (org-element-parse-buffer 'headline)
    'headline
    (lambda (h)
      (org-element-property :todo-type h)))))

(defun vulpea-project-update-tag ()
  "Update PROJECT tag in the current buffer."
  (when (and (not (active-minibuffer-window))
             (vulpea-buffer-p))
    (save-excursion
      (goto-char (point-min))
      (let* ((tags (vulpea-buffer-tags-get))
             (original-tags tags))
        (if (vulpea-project-p)
            (setq tags (cons "project" tags))
          (setq tags (remove "project" tags)))
        (setq tags (seq-uniq tags))
        (when (or (seq-difference tags original-tags)
                  (seq-difference original-tags tags))
          (apply #'vulpea-buffer-tags-set tags))))))

(defun vulpea-project-files ()
  "Return a list of note files containing 'project' tag."
  (seq-uniq
   (seq-map
    #'car
    (org-roam-db-query
     [:select [nodes:file]
      :from tags
      :left-join nodes
      :on (= tags:node-id nodes:id)
      :where (like tag (quote "%\"project\"%"))]))))

(defun vulpea-agenda-files-update (&rest _)
  "Update the value of `org-agenda-files'."
  (setq org-agenda-files
        (append my/org-agenda-base-files
                (vulpea-project-files))))

(add-hook 'find-file-hook #'vulpea-project-update-tag)
(add-hook 'before-save-hook #'vulpea-project-update-tag)
(advice-add 'org-agenda :before #'vulpea-agenda-files-update)
(advice-add 'org-todo-list :before #'vulpea-agenda-files-update)

;;; WSL: hand URLs and files to their Windows default application
;; PowerShell rather than explorer.exe, which misreads some characters and
;; opens File Explorer instead.
(defun my/wsl-start-process (target)
  "Hand TARGET to Windows `Start-Process', using its default association.
TARGET is a URL or a Windows-style path."
  (call-process "/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"
                nil 0 nil "-NoProfile" "-Command"
                (format "Start-Process '%s'"
                        (replace-regexp-in-string "'" "''" target))))

(defun my/wsl-browse-url (url &optional _args)
  "Open URL in the Windows default browser from WSL."
  (my/wsl-start-process url))

(defun my/wsl-open-file (path &optional _link)
  "Open PATH with its Windows default application, as double-clicking would.
PATH is translated to a Windows path first." 
  (my/wsl-start-process
   (string-trim
    (shell-command-to-string
     (format "wslpath -w %s" (shell-quote-argument (expand-file-name path)))))))

(when (getenv "WSL_DISTRO_NAME")
  (setq browse-url-browser-function #'my/wsl-browse-url)
  ;; Follow org links to images and PDFs with the Windows default viewer.
  ;; Prepended, so it wins over org's own .pdf entry and its auto-mode rule
  ;; (auto-mode-alist maps .png to image-mode, useless in a no-image build).
  (with-eval-after-load 'org
    (add-to-list 'org-file-apps
                 '("\\.\\(png\\|jpe?g\\|pdf\\)\\'" . my/wsl-open-file))))

