;;;; Agenda files: the fixed files, plus any roam note containing a task
;; Found by grepping for task headings rather than by maintaining a :project:
;; filetag, so nothing is written back into the notes and there is no database
;; round-trip.  Notes whose tasks are all DONE stay in the list, which is what
;; keeps finished work reachable from a tags search.
(defun my/org-todo-keywords-all ()
  "Every TODO keyword in `org-todo-keywords', fast-access keys stripped.
So \"WAIT(w@/!)\" yields \"WAIT\".  Handles the flat and (sequence ...) forms."
  (let (keywords)
    (dolist (entry (if (stringp (car org-todo-keywords))
                       (list org-todo-keywords)   ; flat form is one sequence
                     org-todo-keywords))
      (dolist (item (if (symbolp (car entry)) (cdr entry) entry))
        (unless (equal item "|")
          (push (replace-regexp-in-string "(.+)\\'" "" item) keywords))))
    (delete-dups (nreverse keywords))))

(defun my/org-roam-task-files ()
  "Roam notes containing at least one task heading, done or not."
  (split-string
   (shell-command-to-string
    (format "rg -l --glob '*.org' -g '!*sync-conflict*' %s %s"
            (shell-quote-argument
             (format "^\\*+ (%s) " (string-join (my/org-todo-keywords-all) "|")))
            (shell-quote-argument (expand-file-name org-roam-directory))))
   "\n" t))

(defun my/org-agenda-files-update (&rest _)
  "Recompute `org-agenda-files' before an agenda or tags search is built."
  (setq org-agenda-files
        (append my/org-agenda-base-files (my/org-roam-task-files))))

(advice-add 'org-agenda     :before #'my/org-agenda-files-update)
(advice-add 'org-todo-list  :before #'my/org-agenda-files-update)
(advice-add 'org-tags-view  :before #'my/org-agenda-files-update)

;;; WSL: hand URLs and files to their Windows default application
;; PowerShell rather than explorer.exe, which misreads some characters and
;; opens File Explorer instead.
(defun my/wsl-start-process (target)
  "Hand TARGET to Windows `Start-Process', using its default association.
TARGET is a URL or a Windows-style path."
  (call-process "/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"
                nil 0 nil "-NoProfile" "-Command"
                (format "Start-Process '%s'"
                        (replace-regexp-in-string "'" "''" target))))

(defun my/wsl-browse-url (url &optional _args)
  "Open URL in the Windows default browser from WSL."
  (my/wsl-start-process url))

(defun my/wsl-open-file (path &optional _link)
  "Open PATH with its Windows default application, as double-clicking would.
PATH is translated to a Windows path first." 
  (my/wsl-start-process
   (string-trim
    (shell-command-to-string
     (format "wslpath -w %s" (shell-quote-argument (expand-file-name path)))))))

(when (getenv "WSL_DISTRO_NAME")
  (setq browse-url-browser-function #'my/wsl-browse-url)
  ;; Follow org links to images and PDFs with the Windows default viewer.
  ;; Prepended, so it wins over org's own .pdf entry and its auto-mode rule
  ;; (auto-mode-alist maps .png to image-mode, useless in a no-image build).
  (with-eval-after-load 'org
    (add-to-list 'org-file-apps
                 '("\\.\\(png\\|jpe?g\\|pdf\\)\\'" . my/wsl-open-file))))

