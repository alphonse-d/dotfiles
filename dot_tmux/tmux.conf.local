# Reload tmux configuration:
# 	 tmux source-file ~/.tmux.conf

# change prefix command
unbind C-b
set -g prefix C-a
bind C-a send-prefix

# See https://superuser.com/questions/252214/ . Decreases delay of sending ESC key.
set -s escape-time 20

#set scrollback limit
set-option -g history-limit 100000

# Colors
set -g status-style bg=colour24,fg=white
set -g status-left '#[bold] LOCAL:#S '

### Display ###
set -g status-position top
# Increase tmux message display duration from 750ms to 4s
set -g display-time 40000
set -g status-interval 5

#set-option -g default-terminal "screen-256color"
set-option -g default-terminal "xterm-256color"
set-option -as terminal-overrides ',xterm-256color:Tc'

set -g xterm-keys off   # stop translating semicolon-modifier sequences
set -g status-keys vi
setw -g mode-keys vi

### navigation
bind a last-window
# Pane navigation like VIM
bind-key h select-pane -L
bind-key j select-pane -D
bind-key k select-pane -U
bind-key l select-pane -R
bind-key -r C-h select-window -t :-
bind-key -r C-l select-window -t :+

# reload config
bind R source-file ~/.tmux.conf
